# Production environment. Copy to .env.prod and fill in every value.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every variable below is required — the compose file fails fast with a named
# error rather than starting with a default, because a silent default here is a
# security incident waiting to happen.
#
# .env.prod is gitignored. Do not commit it.

# ─── Database ─────────────────────────────────────────────────────────────────
# Not the development values. Generate the password, do not choose it:
#   openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── Application ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
# Rotating this invalidates every existing session, which is the emergency
# revocation lever described in SECURITY.md.
JWT_SECRET=

# The origin(s) the API accepts cross-origin requests from, comma-separated.
# The SPA itself is same-origin through nginx and does not need an entry here;
# this is for anything calling the API directly.
#   e.g. https://pharmacy.example.com
CORS_ORIGINS=

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Required. The API refuses to start in production without all five, the same
# way it refuses without JWT_SECRET — because the alternative is an installation
# that accepts password-reset requests, answers them normally and delivers
# nothing. It cannot tell the caller either: the endpoint has to answer
# identically whether or not the address has an account, or it becomes a way to
# ask who banks here.
#
# Nobody requests a password reset on a good day, so a missing value here would
# sit undiscovered until the day it mattered.
#
# 465 is implicit TLS; 587 and 25 start plaintext and upgrade with STARTTLS.
# The port decides which, so there is no way to configure a combination that
# quietly sends these credentials in the clear.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From: address. A display name is fine: "Pharmacy <noreply@example.com>"
SMTP_FROM=

# Where the reset link points — your SPA's public origin, no trailing slash.
# The link is built as ${APP_URL}/reset-password?token=…, so a wrong value here
# sends users somewhere that cannot complete the reset.
APP_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Which peers may set X-Forwarded-For, and therefore what the rate limiter keys
# on. The default covers the compose network. If another proxy or a cloud load
# balancer sits in front of nginx, add its address range.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
