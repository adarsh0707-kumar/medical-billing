# Production environment. Copy to .env.prod and fill in every value.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every variable below is required — the compose file fails fast with a named
# error rather than starting with a default, because a silent default here is a
# security incident waiting to happen.
#
# .env.prod is gitignored. Do not commit it.

# ─── Database ─────────────────────────────────────────────────────────────────
# Not the development values. Generate the password, do not choose it:
#   openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── Application ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
# Rotating this invalidates every existing session, which is the emergency
# revocation lever described in SECURITY.md.
JWT_SECRET=

# The origin(s) the API accepts cross-origin requests from, comma-separated.
# The SPA itself is same-origin through nginx and does not need an entry here;
# this is for anything calling the API directly.
#   e.g. https://pharmacy.example.com
CORS_ORIGINS=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Which peers may set X-Forwarded-For, and therefore what the rate limiter keys
# on. The default covers the compose network. If another proxy or a cloud load
# balancer sits in front of nginx, add its address range.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
