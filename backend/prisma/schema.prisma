generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  /// Set on the seeded bootstrap admin, and on any account an administrator
  /// resets. While true the API refuses every route except signing in, reading
  /// your own profile and changing your password (threat T-2).
  mustChangePassword Boolean @default(false)
  /// Revocation counter. Every issued token carries the value current when it
  /// was signed; `protect` rejects any token whose copy no longer matches.
  /// Incrementing it therefore invalidates every outstanding session for this
  /// user at once — which is what POST /api/auth/logout does (FR-AUTH-09).
  ///
  /// A counter rather than a "valid from" timestamp on purpose: JWT `iat` is
  /// second-granular, so a token signed in the same second as a logout would
  /// compare equal and survive the revocation it was meant to be caught by.
  tokenVersion Int @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices  Invoice[]
  refreshTokens RefreshToken[]
}

/// One row per signed-in device (FR-AUTH-10). The refresh token's `jti` is this
/// row's id, so the server holds authoritative state for a credential the client
/// only carries a copy of.
///
/// Rotation: every use revokes the presented row and issues a new one. That is
/// what makes a stolen refresh token detectable — replaying an already-revoked
/// row is something a legitimate client never does, so it means two parties hold
/// the same credential, and the answer is to end every session for that user.
/// Who changed what, and to what (NFR-17, threat T-12).
///
/// Written by a Prisma middleware rather than by controllers, so a new write
/// path cannot forget to record itself — that is the whole reason it lives at
/// the data layer.
///
/// The actor is a snapshot, not a relation: `actorId` deliberately has no
/// foreign key and `actorEmail` is copied in. An audit trail that loses its
/// attribution when the account is deleted is not an audit trail, and a FK
/// would either block the delete or null the column.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// Null for writes with no signed-in user — the seed script, a migration.
  actorId    String?
  actorEmail String?
  action     String
  /// The Prisma model written to, e.g. "Batch".
  model      String
  recordId   String?
  /// State before and after. Null on create and delete respectively. Password
  /// hashes and token counters are stripped before either is stored.
  before     Json?
  after      Json?
  /// The X-Request-Id of the request that caused it, so an audit row can be
  /// joined back to the log lines for the same request.
  requestId  String?

  @@index([at])
  @@index([model, recordId])
  @@index([actorId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  /// Set the moment the token is rotated or the session ends. A presented token
  /// whose row is already revoked is the reuse signal.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

// ─── Medicine & Inventory ──────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  medicines Medicine[]
}

model Manufacturer {
  id        String     @id @default(cuid())
  name      String     @unique
  medicines Medicine[]
}

/// POS search runs `ILIKE '%q%'` against name and genericName. No b-tree can
/// serve a leading wildcard, so migration `..._add_performance_indexes` also
/// creates a pg_trgm GIN index over both columns. Prisma cannot express that,
/// so it is invisible here — see the migration.
model Medicine {
  id             String       @id @default(cuid())
  name           String
  genericName    String?
  categoryId     String
  manufacturerId String
  hsnCode        String?
  unit           String       // tablet, syrup, injection, etc.
  gstPercent     Decimal      @default(12) @db.Decimal(5, 2) // 0, 5, 12, 18
  isScheduledH   Boolean      @default(false) // prescription required
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category       Category     @relation(fields: [categoryId], references: [id])
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  batches        Batch[]
}

model Batch {
  id             String   @id @default(cuid())
  medicineId     String
  batchNumber    String
  expiryDate     DateTime
  mfgDate        DateTime?
  purchasePrice  Decimal  @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  /// Current stock. A CHECK constraint (`Batch_quantity_non_negative`) keeps this
  /// at or above zero — Prisma cannot express CHECK, so it lives in the migration
  /// `20260820052324_add_batch_quantity_check` and is invisible here otherwise.
  quantity       Int
  initialQty     Int      // when added
  supplierId     String
  createdAt      DateTime @default(now())

  medicine       Medicine      @relation(fields: [medicineId], references: [id])
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]

  @@unique([medicineId, batchNumber])
  // Expiry alerts and FEFO ordering scan this on every dashboard load.
  @@index([expiryDate])
  // Low-stock reporting; a full scan of every batch otherwise.
  @@index([quantity])
  // Prisma does not create FK-side indexes, so the POS search join had none.
  @@index([medicineId])
}

// ─── Customers ─────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?   @unique
  email     String?
  address   String?
  age       Int?
  gender    Gender?
  createdAt DateTime  @default(now())

  invoices  Invoice[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─── Suppliers ─────────────────────────────────────────

model Supplier {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  gstNumber   String?
  address     String?
  createdAt   DateTime   @default(now())

  batches     Batch[]
  purchases   Purchase[]
}

// ─── Billing / Invoices ────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  userId        String
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmt   Decimal       @default(0) @db.Decimal(12, 2)
  cgst          Decimal       @default(0) @db.Decimal(12, 2)
  sgst          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMode   PaymentMode   @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  type          InvoiceType   @default(SALE)
  status        InvoiceStatus @default(ACTIVE)
  /// Set on a credit note: the sale it reverses. Null on a sale.
  reversesId    String?       @unique
  notes         String?
  createdAt     DateTime      @default(now())

  customer      Customer?     @relation(fields: [customerId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         InvoiceItem[]

  /// One credit note per sale, enforced by the unique constraint on reversesId:
  /// that is what makes a double-submitted void restore stock exactly once.
  reverses      Invoice?      @relation("InvoiceReversal", fields: [reversesId], references: [id])
  reversedBy    Invoice?      @relation("InvoiceReversal")

  // The hottest filter in the reporting layer: every report, the invoice list
  // and the trend chart order or range-scan on this.
  @@index([date])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  batchId     String
  medicineName String  // snapshot at time of sale
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2) // percentage, not currency
  gstPercent  Decimal @db.Decimal(5, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  batch       Batch    @relation(fields: [batchId], references: [id])

  // Loading an invoice's lines for display or printing.
  @@index([invoiceId])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

/// Whether a document is a sale or the credit note that reverses one.
/// Kept separate from PaymentStatus: "was it paid" and "is it a reversal" are
/// orthogonal, and folding CANCELLED into PaymentStatus would have made a voided
/// invoice silently vanish from the GST report, which filters on PAID.
enum InvoiceType {
  SALE
  CREDIT_NOTE
}

/// ACTIVE or reversed. A cancelled invoice keeps every figure it was issued with
/// — only this flag moves — because a filed tax period must not change after the
/// fact. The correction is a separate dated document, not an edit.
enum InvoiceStatus {
  ACTIVE
  CANCELLED
}

// ─── Invoice numbering ─────────────────────────────────

// One row per business day. Serials are handed out by an atomic
// INSERT … ON CONFLICT DO UPDATE inside the invoice transaction, which is what
// makes concurrent checkouts safe — a COUNT() of today's invoices is a
// read-then-write race that two counters lose simultaneously.
model InvoiceCounter {
  day String @id // yymmdd, matching the INV prefix
  seq Int
}

// ─── Purchases ─────────────────────────────────────────

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  date           DateTime       @default(now())
  totalAmount    Decimal        @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  batchId     String
  quantity    Int
  costPrice   Decimal  @db.Decimal(12, 2)

  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  batch       Batch    @relation(fields: [batchId], references: [id])
}