generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shops (tenants) ────────────────────────────────────

/// One row per pharmacy. Every other table that holds shop-specific data
/// carries a `shopId` back to this and every query that reads or writes that
/// data is expected to filter on it — this is the whole of the isolation
/// boundary between one shopkeeper's business and another's.
///
/// There is deliberately no cross-shop relation anywhere in this schema.
/// Two shops sharing so much as a Category or a Customer row would be a
/// tenant-isolation break, not a feature, so shared-lookup tables that used to
/// be global (Category, Manufacturer) are now per-shop too, at the cost of
/// each shop typing "Tablet" into its own category list once.
model Shop {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  gstNumber String?
  /// Drug licence number, printed on the invoice header. A retail pharmacy in
  /// India dispenses under a licence and is expected to show it on the bill —
  /// the reference invoice this format follows carries one for both the seller
  /// and the buyer. Nullable, because a shop that has not entered it yet must
  /// still be able to trade.
  drugLicenceNo String?
  createdAt DateTime @default(now())

  users         User[]
  categories    Category[]
  manufacturers Manufacturer[]
  medicines     Medicine[]
  batches       Batch[]
  customers     Customer[]
  suppliers     Supplier[]
  invoices      Invoice[]
  invoiceCounters InvoiceCounter[]
  auditLogs     AuditLog[]
}

// ─── Users & Auth ─────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  /// Global, not per-shop. Login only ever takes an email and a password —
  /// no shop selector — so two accounts sharing an address would be
  /// ambiguous at the one place this table is looked up by it. A person who
  /// runs two shops gets two accounts with two addresses, same as they would
  /// with any other SaaS.
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  /// Set on the seeded bootstrap admin, and on any account an administrator
  /// resets. While true the API refuses every route except signing in, reading
  /// your own profile and changing your password (threat T-2).
  mustChangePassword Boolean @default(false)
  /// Revocation counter. Every issued token carries the value current when it
  /// was signed; `protect` rejects any token whose copy no longer matches.
  /// Incrementing it therefore invalidates every outstanding session for this
  /// user at once — which is what POST /api/auth/logout does (FR-AUTH-09).
  ///
  /// A counter rather than a "valid from" timestamp on purpose: JWT `iat` is
  /// second-granular, so a token signed in the same second as a logout would
  /// compare equal and survive the revocation it was meant to be caught by.
  tokenVersion Int @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id])
  invoices  Invoice[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([shopId])
}

/// Who changed what, and to what (NFR-17, threat T-12).
///
/// Written by a Prisma **client extension** rather than by controllers, so a new
/// write path cannot forget to record itself — that is the whole reason it lives
/// at the data layer. (`src/config/audit.js`.)
///
/// It was a `$use` middleware until 2026-08-31, and this comment said so until
/// 2026-09-04. The move is not cosmetic: a middleware wrote its row on the
/// global client, so an audited write inside a transaction took a *second*
/// pooled connection and its audit row did not roll back with the write it
/// described — the log kept shop creations that never happened. As an extension
/// the row joins the caller's transaction. See docs/03 §3.12 and Phase 13.
///
/// The actor is a snapshot, not a relation: `actorId` deliberately has no
/// foreign key and `actorEmail` is copied in. An audit trail that loses its
/// attribution when the account is deleted is not an audit trail, and a FK
/// would either block the delete or null the column.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// Null for writes with no signed-in user — the seed script, a migration —
  /// and so is this: an unauthenticated write has no shop to attribute it to
  /// either.
  shopId     String?
  /// Null for writes with no signed-in user — the seed script, a migration.
  actorId    String?
  actorEmail String?
  action     String
  /// The Prisma model written to, e.g. "Batch".
  model      String
  recordId   String?
  /// State before and after. Null on create and delete respectively. Password
  /// hashes and token counters are stripped before either is stored.
  before     Json?
  after      Json?
  /// Why, when the caller supplied one. Most writes have no answer beyond what
  /// before/after already shows — a price was changed to this. Some do: a manual
  /// stock adjustment is meaningless without it (FR-BATCH-11), which is why that
  /// endpoint makes it mandatory even though the column is nullable.
  reason     String?
  /// The X-Request-Id of the request that caused it, so an audit row can be
  /// joined back to the log lines for the same request.
  requestId  String?

  shop       Shop?    @relation(fields: [shopId], references: [id])

  @@index([at])
  @@index([model, recordId])
  @@index([actorId])
  @@index([shopId])
}

/// One row per signed-in device (FR-AUTH-10). The refresh token's `jti` is this
/// row's id, so the server holds authoritative state for a credential the client
/// only carries a copy of.
///
/// Rotation: every use revokes the presented row and issues a new one. That is
/// what makes a stolen refresh token detectable — replaying an already-revoked
/// row is something a legitimate client never does, so it means two parties hold
/// the same credential, and the answer is to end every session for that user.
/// A pending self-service password reset (FR-AUTH-11).
///
/// The token itself is never stored. `tokenHash` is a SHA-256 of the random
/// value that went out by email, so a reader of this table — a backup, a dump,
/// an operator with a psql prompt — cannot mint a reset from what they can see.
/// bcrypt is not used here and that is deliberate: the value is 32 bytes of
/// `randomBytes`, not a human-chosen password, so there is nothing to brute
/// force and a slow hash would only make the lookup slow.
///
/// Single use is `usedAt`, not deletion: a row that records having been spent is
/// the difference between "this link was already used" and "this link never
/// existed", and only the first of those tells an operator that somebody clicked
/// twice rather than that somebody is guessing.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the emailed token. Unique so a lookup is an index hit and a
  /// collision is a constraint error rather than an ambiguous match.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// The sweep that clears spent and expired rows reads by date.
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  /// Set the moment the token is rotated or the session ends. A presented token
  /// whose row is already revoked is the reuse signal.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

// ─── Medicine & Inventory ──────────────────────────────

model Category {
  id        String     @id @default(cuid())
  shopId    String
  /// Unique per shop rather than globally now — each shop keeps its own
  /// category list, so two shops can both have a "Tablet" category without
  /// colliding.
  name      String
  shop      Shop       @relation(fields: [shopId], references: [id])
  medicines Medicine[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Manufacturer {
  id        String     @id @default(cuid())
  shopId    String
  name      String
  shop      Shop       @relation(fields: [shopId], references: [id])
  medicines Medicine[]

  @@unique([shopId, name])
  @@index([shopId])
}

/// POS search runs `ILIKE '%q%'` against name and genericName. No b-tree can
/// serve a leading wildcard, so migration `..._add_performance_indexes` also
/// creates a pg_trgm GIN index over both columns. Prisma cannot express that,
/// so it is invisible here — see the migration.
model Medicine {
  id             String       @id @default(cuid())
  shopId         String
  name           String
  genericName    String?
  categoryId     String
  manufacturerId String
  hsnCode        String?
  unit           String       // tablet, syrup, injection, etc.
  /// How the product is packed, as printed on a distributor's invoice:
  /// `1*15ML`, `1*10`, `1*15GM`. Free text on purpose — it is a label copied
  /// off the carton, not a quantity to compute with, and every distributor
  /// writes it slightly differently.
  ///
  /// Distinct from `unit`, which is the dispensing unit ("tablet"). A strip of
  /// ten tablets has unit `tablet` and packSize `1*10`.
  packSize       String?
  gstPercent     Decimal      @default(12) @db.Decimal(5, 2) // 0, 5, 12, 18
  isScheduledH   Boolean      @default(false) // prescription required
  /// Where this medicine is *usually* bought — the "primary supplier" a
  /// distributor master names for each item.
  ///
  /// Distinct from `Batch.supplierId`, and both are needed. The batch records
  /// who a particular consignment actually came from, which is the traceable
  /// fact and the one a recall follows. This records who to reorder from,
  /// which is a preference and can be wrong without making any past purchase
  /// wrong. Reading a default off the most recent batch would conflate the
  /// two: a one-off purchase from whoever had stock that week would silently
  /// become the answer to "who do we buy this from".
  ///
  /// Optional, and `SetNull` on delete: dropping a distributor should clear
  /// the preference rather than refuse the deletion. A batch reference still
  /// blocks it (`P2003` → 409), because that one is history.
  defaultSupplierId String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shop           Shop         @relation(fields: [shopId], references: [id])
  category       Category     @relation(fields: [categoryId], references: [id])
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  defaultSupplier Supplier?   @relation("MedicineDefaultSupplier", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  batches        Batch[]

  @@index([shopId])
  @@index([defaultSupplierId])
}

model Batch {
  id             String   @id @default(cuid())
  /// Denormalised from `medicine.shopId` (and equal to `supplier.shopId`).
  /// The POS search and the low-stock/expiry scans filter batches directly and
  /// in bulk, and both would otherwise need a join through Medicine just to
  /// enforce tenant isolation on every row they touch. Kept in sync because it
  /// is only ever set once, at creation, from the medicine being batched.
  shopId         String
  medicineId     String
  batchNumber    String
  expiryDate     DateTime
  mfgDate        DateTime?
  purchasePrice  Decimal  @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  /// Maximum retail price printed on the pack. Per batch, not per medicine —
  /// the same product is repriced between print runs, which is exactly why a
  /// pharmacy tracks it against the batch it arrived in.
  ///
  /// Nullable, and never used in arithmetic: the sale is priced from
  /// `sellingPrice`. This exists so the invoice can show what the customer
  /// would have paid at list, and it is left out of the printed column
  /// entirely when the shop has not recorded one, rather than being defaulted
  /// to the selling price — printing those as equal would be a claim about
  /// the discount given, on a tax document.
  mrp            Decimal? @db.Decimal(12, 2)
  /// Current stock. A CHECK constraint (`Batch_quantity_non_negative`) keeps this
  /// at or above zero — Prisma cannot express CHECK, so it lives in the migration
  /// `20260820052324_add_batch_quantity_check` and is invisible here otherwise.
  quantity       Int
  initialQty     Int      // when added
  supplierId     String
  createdAt      DateTime @default(now())

  shop           Shop          @relation(fields: [shopId], references: [id])
  medicine       Medicine      @relation(fields: [medicineId], references: [id])
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  invoiceItems   InvoiceItem[]

  @@unique([medicineId, batchNumber])
  // Expiry alerts and FEFO ordering scan this on every dashboard load.
  @@index([expiryDate])
  // Low-stock reporting; a full scan of every batch otherwise.
  @@index([quantity])
  // Prisma does not create FK-side indexes, so the POS search join had none.
  @@index([medicineId])
  // Every dashboard/report/POS query filters on this first.
  @@index([shopId])
}

// ─── Customers ─────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  /// Unique per shop, not globally: the same phone number walking into two
  /// different pharmacies is two different customer records now, same as it
  /// would be with two independent paper registers.
  phone     String?
  email     String?
  address   String?
  age       Int?
  gender    Gender?
  createdAt DateTime  @default(now())
  /// Set when the personal fields above have been blanked, either on request or
  /// by the retention purge. The row itself stays: invoices are append-only and
  /// reference it, and a tax document must not lose its counterparty. So erasure
  /// here means the person is no longer identifiable, not that the sale is gone.
  anonymisedAt DateTime?

  shop      Shop      @relation(fields: [shopId], references: [id])
  invoices  Invoice[]

  @@unique([shopId, phone])
  /// The retention sweep looks for customers whose last invoice predates the
  /// window, and skips anyone already done.
  @@index([anonymisedAt])
  @@index([shopId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─── Suppliers ─────────────────────────────────────────

model Supplier {
  id          String     @id @default(cuid())
  shopId      String
  /// The distributor's own code on the shop's ledger — `SUP-001`. Optional,
  /// because a shop that has never used codes should not be made to invent
  /// them, and unique per shop when present so two cards cannot claim one.
  /// Postgres treats NULLs as distinct, so the many suppliers without a code
  /// do not collide with each other.
  code        String?
  name        String
  contactName String?
  phone       String?
  email       String?
  gstNumber   String?
  /// The street line. `city`, `state` and `pincode` are separate columns
  /// rather than more of this string because they are searched and sorted on,
  /// and because `state` decides the place of supply on a purchase.
  ///
  /// **Note what this system does not yet do with that.** GST on an
  /// inter-state purchase is IGST, not CGST + SGST, and the billing pipeline
  /// only ever computes the intra-state pair. Recording the state does not
  /// make the tax treatment correct — it makes it *visible*, which is the
  /// first of the two.
  address     String?
  city        String?
  state       String?
  /// A string, not a number: Indian PINs are six digits and some begin with a
  /// zero, which an integer column would eat.
  pincode     String?
  /// The distributor's own licence — `BR/PAT/20B-2214, 21B-2215`. A pharmacy
  /// has to be able to show who it bought from was licensed to sell.
  /// Deliberately free text: a state licence number is two or three numbers
  /// with a local format, and a pattern that rejected a valid one would block
  /// a real supplier.
  ///
  /// Spelled the way `Shop.drugLicenceNo` is, so a reader does not have to
  /// remember which model chose which spelling.
  drugLicenceNo String?
  /// Commercial terms, both free text and both for the operator to read rather
  /// than for the system to act on: "30 days credit", "Cash on delivery",
  /// "Mon, Wed, Fri", "On order (2-4 hrs)". Nothing here computes a due date
  /// or a delivery window, and modelling weekdays as an enum would have made
  /// the last of those unstorable.
  paymentTerms String?
  deliveryDays String?
  /// What the shop has agreed it may owe this distributor. Money, so Decimal —
  /// never a Float, for the reason G-07 records. Nothing enforces it; it is
  /// the figure the owner negotiated, recorded where they can see it.
  creditLimit Decimal?   @db.Decimal(12, 2)
  /// Free text about the supplier — what they carry, how they deliver, who to
  /// ask for. The sample master calls this "focus"; it is a remarks field.
  notes       String?
  createdAt   DateTime   @default(now())

  shop        Shop       @relation(fields: [shopId], references: [id])
  batches     Batch[]
  /// Medicines that name this distributor as where they are usually bought.
  /// See `Medicine.defaultSupplierId`.
  preferredFor Medicine[] @relation("MedicineDefaultSupplier")

  @@unique([shopId, code])
  @@index([shopId])
}

// ─── Billing / Invoices ────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  shopId        String
  /// Unique per shop, not globally — each shop numbers its own invoices from
  /// its own `InvoiceCounter`, so "INV-260101-0001" exists once per shop, not
  /// once in the whole system.
  invoiceNumber String
  customerId    String?
  userId        String
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmt   Decimal       @default(0) @db.Decimal(12, 2)
  cgst          Decimal       @default(0) @db.Decimal(12, 2)
  sgst          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMode   PaymentMode   @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  type          InvoiceType   @default(SALE)
  status        InvoiceStatus @default(ACTIVE)
  /// Set on a credit note: the sale it reverses. Null on a sale.
  ///
  /// **No longer unique.** It was, and that uniqueness was half the guard that
  /// made a double-submitted void safe. Partial returns mean one sale can have
  /// several credit notes, so the guarantee moved to a cumulative guard on
  /// `InvoiceItem.returnedQty` — see there.
  reversesId    String?
  notes         String?
  createdAt     DateTime      @default(now())

  shop          Shop          @relation(fields: [shopId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         InvoiceItem[]
  prescription  Prescription?

  /// Several credit notes per sale are now possible, one per partial return.
  reverses      Invoice?      @relation("InvoiceReversal", fields: [reversesId], references: [id])
  reversedBy    Invoice[]     @relation("InvoiceReversal")

  @@unique([shopId, invoiceNumber])
  // The hottest filter in the reporting layer: every report, the invoice list
  // and the trend chart order or range-scan on this.
  @@index([date])
  @@index([customerId])
  @@index([shopId])
}

/// The prescription a Schedule H sale was dispensed against (FR-MED-12, PRD Q4).
///
/// Rule 65(11) of the Drugs and Cosmetics Rules lets a pharmacy record the
/// *particulars* of a prescription in a register instead of retaining the paper.
/// This is that register. What the rule asks for that the invoice does not
/// already carry is the prescriber, the prescription's own date, and the
/// patient's name — the rest (date of supply, drugs, quantities, dispensing
/// pharmacist) is the invoice and its lines.
///
/// One per invoice, not per line: a customer hands over one prescription and it
/// covers every Schedule H item on that bill. A bill needing two prescriptions
/// has to be split, which is what a pharmacist would do at the counter anyway.
///
/// No image. The rules permit the register in lieu of the paper, this stack has
/// no file storage, and a scan would be a second copy of patient-identifying
/// data with its own retention and erasure obligations. Adding one later does
/// not disturb these columns.
model Prescription {
  id              String   @id @default(cuid())
  invoiceId       String   @unique
  /// Registered Medical Practitioner who wrote it.
  prescriberName  String
  /// Their council registration number — the field that makes "registered"
  /// checkable rather than asserted.
  prescriberRegNo String
  /// The date on the prescription, which is not the date of supply.
  prescribedOn    DateTime
  /// Named separately from `Invoice.customerId` because a Schedule H sale can be
  /// a walk-in with no customer record, and the register still needs a patient.
  ///
  /// **Erasure does not reach this column, deliberately.** Blanking a customer
  /// clears `Customer` and sweeps the audit trail, but the register is a
  /// statutory record: Rule 65(11) requires the pharmacy to be able to produce
  /// the particulars of a Schedule H supply, and a right to erasure does not
  /// override an obligation to retain. So an erased customer's name survives
  /// here, for any Schedule H medicine they were dispensed. That is a real limit
  /// on the erasure promise — see `utils/erase-customer.js` and docs/03 §8.
  patientName     String
  notes           String?
  createdAt       DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])

  /// "Show me everything dispensed against this prescriber" is the query an
  /// inspection asks.
  @@index([prescriberRegNo])
  @@index([prescribedOn])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  batchId     String
  medicineName String  // snapshot at time of sale
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2) // percentage, not currency
  gstPercent  Decimal @db.Decimal(5, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  /// Units returned from this line so far, across every credit note against the
  /// invoice. Never exceeds `quantity`.
  ///
  /// This is the cumulative guard that replaced the unique index on
  /// `Invoice.reversesId`. A return applies with a conditional update —
  /// `where returnedQty <= quantity - n` — so two simultaneous returns of the
  /// same units cannot both succeed: the second matches zero rows and rolls its
  /// whole transaction back. The same shape as the stock decrement in G-09, and
  /// for the same reason: a read-then-write pair is not a guard.
  returnedQty Int     @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  batch       Batch    @relation(fields: [batchId], references: [id])

  // Loading an invoice's lines for display or printing.
  @@index([invoiceId])
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

/// Whether a document is a sale or the credit note that reverses one.
/// Kept separate from PaymentStatus: "was it paid" and "is it a reversal" are
/// orthogonal, and folding CANCELLED into PaymentStatus would have made a voided
/// invoice silently vanish from the GST report, which filters on PAID.
enum InvoiceType {
  SALE
  CREDIT_NOTE
}

/// ACTIVE or reversed. A cancelled invoice keeps every figure it was issued with
/// — only this flag moves — because a filed tax period must not change after the
/// fact. The correction is a separate dated document, not an edit.
enum InvoiceStatus {
  ACTIVE
  CANCELLED
}

// ─── Invoice numbering ─────────────────────────────────

// One row per business day. Serials are handed out by an atomic
// INSERT … ON CONFLICT DO UPDATE inside the invoice transaction, which is what
// makes concurrent checkouts safe — a COUNT() of today's invoices is a
// read-then-write race that two counters lose simultaneously.
model InvoiceCounter {
  shopId String
  day    String // yymmdd, matching the INV prefix
  seq    Int

  shop   Shop   @relation(fields: [shopId], references: [id])

  // One row per shop per day, not one per day: two shops issuing their INV-
  // 260101-0001 on the same date must not share a counter, or the atomic
  // upsert that hands out serials would serialise unrelated shops' checkouts
  // against each other and hand out numbers neither shop's series expects.
  @@id([shopId, day])
}
